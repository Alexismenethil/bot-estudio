DATABASE_URL=postgres://...          # Neon connection string (pgvector enabled)
APP_PASSCODE=...                     # entry lock passcode (FR-026)
SESSION_SECRET=...                   # >=32 random bytes, HS256 cookie signing (see src/proxy.ts)
GEMINI_API_KEY=...                   # Gemini API key (gemini-2.5-flash)
BLOB_READ_WRITE_TOKEN=...            # Vercel Blob store token (PDF storage)
